#!/bin/sh
# The test sets (test/<set>.json) and the tests' categories (test/<test>/test.json) agree.
cd "$(dirname "$0")/.." || exit 1
exec node -e '
const fs = require("fs"), path = require("path")
const json = f => JSON.parse(fs.readFileSync(f, "utf8"))
const sets = Object.fromEntries(fs.readdirSync(".").filter(f => f.endsWith(".json")).map(f => [f.slice(0, -5), json(f)]))
const tests = fs.readdirSync(".").filter(d => fs.statSync(d).isDirectory())
let n = 0, pass = 0
const check = (c, what) => { n++; if (c) pass++; console.log(`${c ? "ok" : "not ok"} ${n} - ${what}`) }
for (const [s, def] of Object.entries(sets)) for (const t of def.tests || []) check(fs.existsSync(path.join(t, "test")) || fs.existsSync(path.join(t, "boot")), `${s}: ${t} is there, with a test or a boot script`)
for (const t of tests) {
  const cats = fs.existsSync(path.join(t, "test.json")) ? json(path.join(t, "test.json")).categories || [] : []
  const named = Object.keys(sets).filter(s => (sets[s].tests || []).includes(t))
  check(named.length > 0, `${t}: in a set`)
  check(JSON.stringify([...cats].sort()) === JSON.stringify(named.sort()), `${t}: its categories (${cats.join(", ")}) are the sets that name it (${named.join(", ")})`)
}
console.log(`# tests ${n}\n# pass ${pass}`)
process.exit(pass === n ? 0 : 1)
'
