{
  "name": "dev-env-2-p2p-cluster",
  "private": true,
  "type": "module",
  "description": "The p2p series as one dependency tree (npm workspaces): each module a folder (pear-full-square/<module>), their dependencies resolved together. The dependencies here are what the applications composing them need: Bare's aliases for Node's built-ins.",
  "workspaces": [
    "pear-full-square/p2p-store",
    "pear-full-square/p2p-dht",
    "pear-full-square/p2p-connect",
    "pear-full-square/p2p-replicate",
    "pear-full-square/p2p-channel",
    "pear-full-square/p2p-mrepo",
    "pear-full-square/p2p-rns",
    "pear-full-square/p2p-node",
    "pear-full-square/p2p-node-manager",
    "pear-full-square/p2p-swarm-manager",
    "pear-full-square/splectral-p2p-observer",
    "pear-full-square/splectral-contract",
    "pear-full-square/splectral-model",
    "pear-full-square/splectral-transport",
    "pear-full-square/splectral-server",
    "pear-full-square/splectral-shell",
    "pear-full-square/splectral-replay",
    "pear-full-square/splectral-scenario",
    "pear-full-square/splectral-timeline",
    "pear-full-square/splectral-p2p-watchers",
    "pear-full-square/splectral-p2p-actions"
  ],
  "dependencies": {
    "child_process": "npm:bare-node-child-process@1.0.1",
    "fs": "npm:bare-node-fs@1.0.2",
    "path": "npm:bare-node-path@1.0.1",
    "process": "npm:bare-node-process@1.0.1",
    "url": "npm:bare-node-url@1.0.1",
    "util": "npm:bare-node-util@1.0.0"
  }
}
